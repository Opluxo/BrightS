#!/System/bin/busybox sh

export PATH=/System/bin:/System/sbin:/System/usr/bin
export HOME=/User
export LD_LIBRARY_PATH=/System/usr/lib:/System/lib

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mount -t tmpfs none /run
mount -t tmpfs none /tmp

hostname brights

echo ""
echo "BrightS v0.2c booted."
echo ""

if [ -e /dev/dri/card0 ]; then
    echo "[ok] /dev/dri/card0 exists"
else
    echo "[warn] /dev/dri/card0 missing"
fi

echo ""
/System/usr/bin/drm-test
echo ""

# Self-test mode (CI, and scripts/boot-test.sh locally): print a marker and
# power the machine off instead of dropping into an interactive shell, so the
# VM terminates on its own rather than waiting for a timeout.
if grep -q brights.selftest /proc/cmdline 2>/dev/null; then
    echo "[selftest] BrightS v0.2c boot ok"
    sync
    exec /System/sbin/poweroff -f
fi

echo "Entering shell."
echo ""

exec /System/bin/sh </dev/ttyAMA0 >/dev/ttyAMA0 2>&1
